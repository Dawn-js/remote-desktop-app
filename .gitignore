# 编译产物
*.exe
*.out
*.o
*.obj
*.a
*.so
*.dll
*.dylib

# 日志文件
*.log
*.tmp
*.temp

# 依赖文件夹（如果使用包管理）
node_modules/
vendor/
venv/
__pycache__/
*.py[cod]

# 配置文件（如果包含敏感信息）
.env
*.local
config.ini
*.secret

# 编辑器临时文件
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# IDE 目录
.idea/
.vscode/
*.iml

# 备份文件
*.bak
*.backup

# 你项目的特定二进制文件（如果有）
remote-desktop-app   # 如果编译后的可执行文件就叫这个名字
